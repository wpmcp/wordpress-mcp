# What bin/brand-wpmcp.php leaves alone.
#
# One entry per line; blank lines and lines starting with # are ignored.
#
#   <glob>         a path relative to the repository root (files of the pro/
#                  submodule start with pro/). * matches within one
#                  directory, ** across directories, and a trailing / takes
#                  everything under it.
#   keep: <text>   every line, in any file, that contains <text> is left
#                  exactly as it is: for strings the code compares, hashes or
#                  persists, where a new spelling would change behavior.
#
# The script always skips itself and this file, and the Changelog and Upgrade
# Notice entries of released versions in every readme.txt.

# Regenerated, not rewritten: the script runs make-pot for the .pot, and rule
# 13 of docs/CODING-STANDARD.md regenerates the golden capture.
languages/wpmcp.pot
tests/support/golden/baseline/

# Dated design specs and plans: records of what was decided at the time, in
# the name the product had then.
docs/superpowers/

# Spells the old name on purpose: it is what the guard looks for.
tests/free/Lint/BrandNameGuardTest.php

# The header Widget_Compiler writes into every compiled Elementor widget.
# Compiled_Widget_Manifest::status_for() compiles the spec again and compares
# the hash with the stored one, so a new header would report every widget
# compiled before the rename as stale until it is recompiled.
keep: Generated by WP MCP from custom widget spec #

# The text of the .wpmcp-pro marker in the premium zip: scripts/build-release.sh
# writes it and scripts/lib/pro-leak-gate.sh compares it byte for byte. A build
# marker that no one reads.
keep: WP MCP premium build
